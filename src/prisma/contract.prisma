// use prisma-next

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  orders      Order[]
}

model Event {
  id            String   @id @default(uuid())
  title         String
  totalStock    Int
  price         Decimal
  orders        Order[]
  reservedStock Int @default(0)
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  eventId           String
  status            OrderStatus @default(PENDING)
  snapToken         String?
  paymentUrl        String?
  createdAt         DateTime    @default(now())
  reservedAt        DateTime?
  expiresAt         DateTime?
  paymentGatewayRef String?

  user        User        @relation(fields: [userId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}
